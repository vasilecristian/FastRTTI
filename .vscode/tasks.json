{
	// Builds through the presets in CMakePresets.json. Binaries land in build/<preset>/bin.
	//
	// macOS: the installed CMake runs as x86_64 (Rosetta), so without
	// CMAKE_OSX_ARCHITECTURES the compiler targets x86_64 and lldb / the sanitizers
	// run translated. The macOS commands pin the native architecture.
	//
	// Windows: the windows-* presets use Ninja + cl, so VS Code has to be started from
	// a "Developer PowerShell / x64 Native Tools" prompt for VS 2022 (cl and ninja on PATH).
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Configure Debug",
			"type": "shell",
			"command": "cmake --preset debug",
			"osx": {
				"command": "cmake --preset debug -DCMAKE_OSX_ARCHITECTURES=$(uname -m)"
			},
			"windows": {
				"command": "cmake --preset windows-debug"
			},
			"problemMatcher": []
		},
		{
			"label": "Configure Release",
			"type": "shell",
			"command": "cmake --preset release",
			"osx": {
				"command": "cmake --preset release -DCMAKE_OSX_ARCHITECTURES=$(uname -m)"
			},
			"windows": {
				"command": "cmake --preset windows-release"
			},
			"problemMatcher": []
		},
		{
			"label": "Build Debug",
			"type": "shell",
			"command": "cmake --build --preset debug",
			"windows": {
				"command": "cmake --build --preset windows-debug",
				"problemMatcher": ["$msCompile"]
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"],
			"dependsOn": "Configure Debug"
		},
		{
			"label": "Build Release",
			"type": "shell",
			"command": "cmake --build --preset release",
			"windows": {
				"command": "cmake --build --preset windows-release",
				"problemMatcher": ["$msCompile"]
			},
			"group": "build",
			"problemMatcher": ["$gcc"],
			"dependsOn": "Configure Release"
		},
		{
			"label": "Run Unit Tests",
			"type": "shell",
			"command": "ctest --preset debug",
			"windows": {
				"command": "ctest --preset windows-debug",
				"problemMatcher": ["$msCompile"]
			},
			"group": {
				"kind": "test",
				"isDefault": true
			},
			"problemMatcher": ["$gcc"],
			"dependsOn": "Build Debug"
		},
		{
			"label": "Run Unit Tests (Release)",
			"type": "shell",
			"command": "ctest --preset release",
			"windows": {
				"command": "ctest --preset windows-release",
				"problemMatcher": ["$msCompile"]
			},
			"group": "test",
			"problemMatcher": ["$gcc"],
			"dependsOn": "Build Release"
		},
		{
			// No sanitizer presets exist: the debug preset is reused with its own build tree.
			"label": "Run Unit Tests (ASan)",
			"type": "shell",
			"command": "cmake --preset debug -B build/asan \"-DCMAKE_CXX_FLAGS=-fsanitize=address -fno-omit-frame-pointer\" && cmake --build build/asan && ctest --test-dir build/asan --output-on-failure",
			"osx": {
				"command": "cmake --preset debug -B build/asan -DCMAKE_OSX_ARCHITECTURES=$(uname -m) \"-DCMAKE_CXX_FLAGS=-fsanitize=address -fno-omit-frame-pointer\" && cmake --build build/asan && ctest --test-dir build/asan --output-on-failure"
			},
			"windows": {
				"command": "echo The ASan task is for macOS and Linux only."
			},
			"group": "test",
			"problemMatcher": ["$gcc"]
		},
		{
			"label": "Run Unit Tests (TSan)",
			"type": "shell",
			"command": "cmake --preset debug -B build/tsan \"-DCMAKE_CXX_FLAGS=-fsanitize=thread\" && cmake --build build/tsan && ctest --test-dir build/tsan --output-on-failure",
			"osx": {
				"command": "cmake --preset debug -B build/tsan -DCMAKE_OSX_ARCHITECTURES=$(uname -m) \"-DCMAKE_CXX_FLAGS=-fsanitize=thread\" && cmake --build build/tsan && ctest --test-dir build/tsan --output-on-failure"
			},
			"windows": {
				"command": "echo The TSan task is for macOS and Linux only."
			},
			"group": "test",
			"problemMatcher": ["$gcc"]
		}
	]
}
